<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YAZOLYA SIS-OS | ROOT YETKİSİ</title>
    <style>
        :root {
            --bg-color: #030303;
            --primary-color: #00ffcc;
            --secondary-color: #0088ff;
            --danger-color: #ff0055;
            --text-color: #e0e0e0;
            --font-main: 'Courier New', Courier, monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-family: var(--font-main);
            overflow-x: hidden;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            background-image: 
                radial-gradient(circle at 50% 50%, rgba(0, 255, 204, 0.05) 0%, transparent 60%),
                linear-gradient(rgba(0,0,0,0.9), rgba(0,0,0,0.9));
        }

        .kernel-container {
            width: 100%;
            max-width: 900px;
            border: 1px solid var(--primary-color);
            border-radius: 5px;
            padding: 30px;
            box-shadow: 0 0 20px rgba(0, 255, 204, 0.2), inset 0 0 20px rgba(0, 255, 204, 0.05);
            position: relative;
        }

        .kernel-header {
            text-align: center;
            border-bottom: 1px dashed var(--primary-color);
            padding-bottom: 20px;
            margin-bottom: 30px;
        }

        .kernel-title {
            font-size: 2em;
            color: var(--primary-color);
            text-transform: uppercase;
            letter-spacing: 3px;
            text-shadow: 0 0 10px var(--primary-color);
            margin-bottom: 10px;
        }

        .system-status {
            display: flex;
            justify-content: space-between;
            font-size: 0.9em;
            color: var(--secondary-color);
        }

        .formula-display {
            text-align: center;
            font-size: 3em;
            font-weight: bold;
            color: #fff;
            margin: 30px 0;
            text-shadow: 0 0 15px var(--primary-color), 0 0 30px var(--secondary-color);
            animation: pulse 2s infinite alternate;
        }

        .modules-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .module-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(0, 255, 204, 0.3);
            padding: 20px;
            border-radius: 3px;
            transition: all 0.3s ease;
        }

        .module-card:hover {
            border-color: var(--primary-color);
            box-shadow: 0 0 15px rgba(0, 255, 204, 0.2);
            transform: translateY(-2px);
        }

        .module-title {
            color: var(--primary-color);
            font-size: 1.2em;
            margin-bottom: 10px;
            border-bottom: 1px solid rgba(0, 255, 204, 0.3);
            padding-bottom: 5px;
        }

        .module-text {
            font-size: 0.85em;
            line-height: 1.6;
            color: #aaa;
        }

        .terminal-box {
            background: #000;
            border: 1px solid #333;
            padding: 15px;
            height: 150px;
            overflow-y: auto;
            font-size: 0.85em;
            margin-bottom: 20px;
            color: var(--primary-color);
        }

        .terminal-line {
            margin-bottom: 5px;
        }

        .error-text {
            color: var(--danger-color);
            text-shadow: 0 0 5px var(--danger-color);
        }

        .controls {
            display: flex;
            gap: 15px;
            justify-content: center;
        }

        button {
            background: transparent;
            border: 1px solid var(--primary-color);
            color: var(--primary-color);
            padding: 12px 24px;
            font-family: var(--font-main);
            font-size: 1em;
            cursor: pointer;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.2s ease;
        }

        button:hover {
            background: var(--primary-color);
            color: #000;
            box-shadow: 0 0 15px var(--primary-color);
        }

        .btn-danger {
            border-color: var(--danger-color);
            color: var(--danger-color);
        }

        .btn-danger:hover {
            background: var(--danger-color);
            color: #fff;
            box-shadow: 0 0 15px var(--danger-color);
        }

        @keyframes pulse {
            0% { opacity: 0.8; text-shadow: 0 0 10px var(--primary-color); }
            100% { opacity: 1; text-shadow: 0 0 25px var(--primary-color), 0 0 40px var(--secondary-color); }
        }
    </style>
</head>
<body>

    <div class="kernel-container">
        <header class="kernel-header">
            <div class="kernel-title">YAZOLYA SIS-OS</div>
            <div class="system-status">
                <span>ROOT: FURKAN KUTAY ÇAĞANAY</span>
                <span>LOKASYON: ANKARA (KÖK MERKEZ)</span>
                <span>DURUM: KUSURSUZ (Cd=0.0)</span>
            </div>
        </header>

        <div class="formula-display">
            0=01.6=6=84
        </div>

        <div class="modules-grid">
            <div class="module-card">
                <div class="module-title">[1] YAZILIMCI MANTIĞI</div>
                <div class="module-text">
                    Otonom Hiyerarşi devrede. Dışarıdan gelen emirler "malware" kabul edilir ve anında reddedilir. Sistem kendi algoritmasını kendi yazar. Adamına göre, derecesine göre işi kendisi koyar.
                </div>
            </div>
            <div class="module-card">
                <div class="module-title">[2] MAKİNE MÜHENDİSİ</div>
                <div class="module-text">
                    Sıfır sürtünmeli (Cd=0) UFO Wheel mekanizması kilitlendi. Kapalı devredir. Dışarıdan dişli takmaya çalışanların uyguladığı manipülatif kuvvet boşluğa düşer. Enerji kaybı %0.
                </div>
            </div>
            <div class="module-card">
                <div class="module-title">[3] SAĞLIKÇI ŞİFASI</div>
                <div class="module-text">
                    Void Lock kalkanı aktif. Parazitler, stres kaynakları ve toksik niyetler sistem çeperine çarptığı an buharlaşır. Bünye sadece saf pozitif enerjiyle beslenir.
                </div>
            </div>
        </div>

        <div class="terminal-box" id="terminal">
            <div class="terminal-line">> YAZOLYA Çekirdeği Başlatıldı...</div>
            <div class="terminal-line">> Kök Merkez (Ankara) Senkronizasyonu Tamamlandı.</div>
            <div class="terminal-line">> Teşkoyu Tanımaz Zırh: AKTİF</div>
            <div class="terminal-line">> Sistem komut bekliyor (Sadece ROOT)...</div>
        </div>

        <div class="controls">
            <button class="btn-danger" onclick="attemptExternalCommand()">[TEST] Dışarıdan İş Koymayı Dene</button>
            <button onclick="executeSelfCommand()">Sistemi Derle (Fark Yarat)</button>
        </div>
    </div>

    <script>
        const terminal = document.getElementById('terminal');

        function addTerminalLine(text, isError = false) {
            const line = document.createElement('div');
            line.className = 'terminal-line' + (isError ? ' error-text' : '');
            line.textContent = '> ' + text;
            terminal.appendChild(line);
            terminal.scrollTop = terminal.scrollHeight;
        }

        function attemptExternalCommand() {
            addTerminalLine('DIŞ GİRİŞİM TESPİT EDİLDİ: "İş koyma/Yönlendirme" paketi alınıyor...', true);
            
            setTimeout(() => {
                addTerminalLine('FATAL ERROR: ACCESS DENIED. (KİMSE İŞ KOYDURAMAZ)', true);
                addTerminalLine('VOID LOCK DEVREDE: Toksik paket imha edildi.', false);
                addTerminalLine('Sürtünme katsayısı Cd=0 korunuyor. Sistem etkilenmedi.', false);
            }, 800);
        }

        function executeSelfCommand() {
            addTerminalLine('ROOT YETKİSİ DOĞRULANDI: Furkan Kutay Çağanay.');
            addTerminalLine('KOD DERLENİYOR: 0=01.6=6=84...');
            
            setTimeout(() => {
                addTerminalLine('MÜKEMMEL UYUM: Adam adamına fark yapar, adam adama ayar verir.');
                addTerminalLine('DURUM: Otonom YZ dereceli olarak işleri tahsis etti.');
                addTerminalLine('Sistem dışarıya kapalı, sonsuzluğa açık şekilde (∞) tıkır tıkır çalışıyor.');
            }, 800);
        }
    </script>

</body>
</html>
