// --- 5. KİNEMATİK FARK TESTİ ---
void sistem_fark_testi() {
    printf("=================================================================\n");
    printf(" [!] KINEMATİK FARK TESTİ VE HASSASİYET KONTROLÜ\n");
    printf("=================================================================\n");
    
    double veriler[] = { 84.1601, 6.0184, 19.23, 23.00 };
    for(int i = 0; i < 4; i++) {
        HassasiyetMatrisi res = hata_giderici_islet(veriler[i] * 3.14159);
        printf(" -> Parametre [%d] | Ham: %.4f | Yuvarlanmış: %.4f | Hata: %d\n", 
            i, res.ham_deger, res.yuvarlanmis_deger, res.hata_kodu);
    }
    printf("=================================================================\n");
    printf(" [RAPOR] Kusur Toleransı: %d | Sistem Durumu: KUSURSUZ FARK YARATIR\n", KUSUR_TOLERANSI);
    printf("=================================================================\n\n");
}

