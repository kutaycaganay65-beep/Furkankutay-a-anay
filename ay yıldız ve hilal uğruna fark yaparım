#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <stdbool.h>
#include <string.h>

#define KUSUR_TOLERANSI 0
#define CD_ZERO 0.0
#define KINEMATIK_SABIT "0=01.6=6=84"
#define VATAN_HILAL "Ay Yıldız ve Hilal Uğruna"

typedef struct {
    double ham_deger;
    double yuvarlanmis_deger;
    int hata_kodu;
} HassasiyetMatrisi;

// --- 1. ERROR-NULLIFIER MATRİSİ (Kusur Toleransı: 0) ---
HassasiyetMatrisi hata_giderici_islet(double girdi) {
    HassasiyetMatrisi m;
    m.ham_deger = girdi;
    m.yuvarlanmis_deger = round(girdi * 10000.0) / 10000.0;
    
    if (isnan(girdi) || isinf(girdi)) {
        m.hata_kodu = -1; // Sapma tespit edildi, anında sıfırlandı
        m.yuvarlanmis_deger = 0.0;
    } else {
        m.hata_kodu = 0; // Kusursuz denge
    }
    return m;
}

// --- 2. TEŞKO TANIMAZ & ADAM ADAMLA İŞ YAPAR (VOID LOCK) ---
