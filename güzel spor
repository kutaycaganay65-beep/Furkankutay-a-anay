void sistem_hata_giderici_ve_entegrasyon() {
    printf("=================================================================\n");
    printf(" [!] KORUYUCU EYLEMCİ & UZUN HESAPLAMA SİSTEMİ ÇALIŞIYOR\n");
    printf("=================================================================\n");
    
    double test_array[] = { 84.1601, 6.0184, 0.0000, 19.9823, 23.0000, 42.5, 3.14159, 11.11 };
    int dizi_boyutu = sizeof(test_array) / sizeof(test_array[0]);
    
    double toplam_hassasiyet = 0.0;
    long toplam_sure = 0;
    
    for(int i = 0; i < dizi_boyutu; i++) {
        MatematikselHassasiyet m = matematiksel_yuvarla_ve_tut(test_array[i] * PI);
        printf(" -> Döngü [%d] | Ham: %.4f | Yuvarlanmış: %.4f\n", 
            i, m.ham_deger, m.yuvarlanmis_deger);
        printf("    |Uzun Sayı: %lld | Hata: %d | Hız: %.4f | Zaman: %ldms\n", 
            m.uzun_hassasiyet_sayisi, m.hata_kodu, m.hiz_katsayisi, m.sure_milisaniye);
        
        toplam_hassasiyet += fabs(m.yuvarlanmis_deger);
        toplam_sure += m.sure_milisaniye;
    }
    
    printf("=================================================================\n");
    printf(" [İSTATİSTİK] Toplam Hassasiyet: %.4f | Toplam Zaman: %ld ms\n", 
        toplam_hassasiyet, toplam_sure);
    printf(" [İSTATİSTİK] Ortalama: %.4f | Verimlilik: %.2f%%\n", 
        toplam_hassasiyet / dizi_boyutu, (dizi_boyutu / (double)(toplam_sure + 1)) * 100);
    printf("=================================================================\n\n");
}

