} SistemVeriTorbasi;

// --- İLERİ MATEMATİKSEL MOTOR ---
MatematikselHassasiyet matematiksel_yuvarla_ve_tut(double girdi_sayi) {
    MatematikselHassasiyet sonuc;
    clock_t bas = clock();
    
    sonuc.ham_deger = girdi_sayi;
    sonuc.yuvarlanmis_deger = round(girdi_sayi * 10000.0) / 10000.0;
    sonuc.uzun_hassasiyet_sayisi = (long long)(girdi_sayi * 84001601ULL);
    
    // Performans hızı: Veri işleme çabukluğu
    sonuc.hiz_katsayisi = fabs(girdi_sayi) > 1e-9 ? 1.0 / fabs(girdi_sayi) : 1.0;
    
    if (isnan(girdi_sayi) || isinf(girdi_sayi)) {
        sonuc.hata_kodu = -1;
        sonuc.yuvarlanmis_deger = 0.0;
        sonuc.hiz_katsayisi = 0.0;
    } else {
        sonuc.hata_kodu = 0;
    }
    
    clock_t son = clock();
    sonuc.sure_milisaniye = (son - bas) * 1000 / CLOCKS_PER_SEC;
    
    return sonuc;
}

// --- SPOR VE BİLİŞSEL MOTOR ---
SporModulu spor_modulu_olustur(const char *isim, int seviye, double skor, int saat) {
    SporModulu spor;
    strncpy(spor.spor_adi, isim, 49);
    spor.spor_adi[49] = '\0';
    spor.beceri_seviyesi = seviye;
    spor.performans_skoru = skor;
    spor.antrenman_saati = saat;
    return spor;
}

void spor_bilgisi_goster(SporModulu spor) {
    printf("   [SPOR] %s\n", spor.spor_adi);
