// --- VERİ YAPILARI ---
typedef struct {
    double ham_deger;
    double yuvarlanmis_deger;
    long long uzun_hassasiyet_sayisi;
    int hata_kodu;
    double hiz_katsayisi;
    long sure_milisaniye;
} MatematikselHassasiyet;

typedef struct {
    char spor_adi[50];
    int beceri_seviyesi;
    double performans_skoru;
    int antrenman_saati;
} SporModulu;

typedef struct {
    MatematikselHassasiyet *veriler;
