    <script>
        function calculatePi() {
            const steps = parseInt(document.getElementById('slider').value);
            document.getElementById('iterCount').innerText = steps;
            let pi = 0.0;
            let sign = 1.0;
            for (let i = 0; i < steps; i++) {
                pi += sign / (2 * i + 1);
                sign *= -1.0;
            }
            pi *= 4;
            document.getElementById('piOutput').innerText = "Korumalı Sonuç (&pi;): " + pi.toFixed(10);
        }
        document.getElementById('slider').addEventListener('input', calculatePi);
        calculatePi();
    </script>

