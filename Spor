<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Furkan Kutay Çağanay • Her Şeyi Çözen Mutlak Spor & Eğitim Sistemi v16.0</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=JetBrains+Mono:wght@400;700&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .cinzel-font { font-family: 'Cinzel', serif; }
        .mono-font { font-family: 'JetBrains Mono', monospace; }
        .glass-panel {
            background: rgba(4, 7, 13, 0.96);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(212, 175, 55, 0.5);
        }
        .gold-glow { text-shadow: 0 0 40px rgba(212, 175, 55, 0.8); }
        .golden-border { border-image: linear-gradient(to right, #d4af37, #e2e8f0, #d4af37) 1; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #02040a; }
        ::-webkit-scrollbar-thumb { background: #d4af37; border-radius: 4px; }
        @keyframes quantumPulse {
            0%, 100% { box-shadow: 0 0 40px rgba(212, 175, 55, 0.3), inset 0 0 20px rgba(212, 175, 55, 0.15); }
            50% { box-shadow: 0 0 80px rgba(212, 175, 55, 0.7), inset 0 0 40px rgba(212, 175, 55, 0.4); }
        }
        .quantum-shield { animation: quantumPulse 3s infinite ease-in-out; }
    </style>
</head>
<body class="bg-[#02040a] text-slate-100 min-h-screen selection:bg-amber-500 selection:text-slate-950 pb-32">

    <header class="sticky top-0 z-50 glass-panel border-b border-amber-500/30">
        <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-600 via-yellow-400 to-slate-200 flex items-center justify-center font-black text-xl text-slate-950 shadow-2xl shadow-amber-500/50 cinzel-font">
                    FKÇ
                </div>
                <div>
                    <h1 class="text-base sm:text-lg font-black tracking-tight text-white flex items-center gap-2 cinzel-font">
                        MUTLAK ÇÖZÜM SİSTEMİ
                        <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping" title="Sistem Aktif"></span>
                    </h1>
                    <p class="text-xs text-amber-400 font-semibold uppercase tracking-wider mono-font">Furkan Kutay Çağanay • Her Şeyi Çözen Master Konsol</p>
                </div>
            </div>
            <nav class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 text-xs sm:text-sm font-medium text-slate-300">
                <button onclick="switchTab('dashboard')" class="tab-btn px-4 py-2 rounded-xl bg-amber-500/15 text-amber-300 border border-amber-500/40 transition shadow-sm font-bold">⚡ Her Şeyi Çöz</button>
                <button onclick="switchTab('workout')" class="tab-btn px-4 py-2 rounded-xl hover:bg-slate-800 hover:text-amber-300 transition">🏋️ Spor & Koçluk</button>
                <button onclick="switchTab('academy')" class="tab-btn px-4 py-2 rounded-xl hover:bg-slate-800 hover:text-amber-300 transition">📚 Öğretici Külliyat</button>
                <button onclick="switchTab('shield')" class="tab-btn px-4 py-2 rounded-xl hover:bg-slate-800 hover:text-amber-300 transition">🛡️ Kuantum Koruma</button>
            </nav>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 pt-10 space-y-12">
        
        <!-- DASHBOARD TAB: HER ŞEYİ ÇÖZEN MASTER PANEL -->
        <div id="tab-dashboard" class="space-y-8">
            <section class="glass-panel rounded-3xl p-8 sm:p-12 relative overflow-hidden shadow-2xl quantum-shield golden-border border-t-2 border-b-2">
                <div class="absolute -right-32 -top-32 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
                
                <div class="relative z-10 grid lg:grid-cols-2 gap-10 items-center">
                    <div class="space-y-6">
                        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold uppercase tracking-wider mono-font">
                            <span>Zero-Dependency (Sıfır Bağımlılık) Protokolü</span>
                        </div>
                        <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white gold-glow cinzel-font leading-tight">
                            Hayatını, Sporunu ve Zihnini Tek Tıkla Mühürle
                        </h2>
                        <p class="text-sm sm:text-base text-slate-300 font-normal leading-relaxed">
                            Alet gerektirmeyen calisthenics gücü, saniyenin onda birlik rekor disiplini ve yapay zekâ destekli anlık karar motoru ile tüm sorunlarınız tek bir ekranda çözülüyor.
                        </p>
                        
                        <div class="flex flex-wrap gap-3">
                            <button onclick="executeTotalMasterSolution()" class="px-6 py-4 rounded-xl bg-gradient-to-r from-amber-600 via-yellow-500 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-slate-950 font-extrabold text-sm transition shadow-lg shadow-amber-500/30 flex items-center gap-2">
                                <span>🚀 Tek Tuşla Her Şeyi Çöz ve Başlat</span>
                            </button>
                        </div>
                    </div>

                    <!-- Master Terminal -->
                    <div class="flex flex-col rounded-2xl bg-slate-950 border border-slate-800 overflow-hidden shadow-inner">
                        <div class="px-4 py-3 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
                            <div class="flex items-center space-x-2">
                                <div class="w-3 h-3 rounded-full bg-rose-500"></div>
                                <div class="w-3 h-3 rounded-full bg-amber-500"></div>
                                <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
                                <span class="text-xs text-slate-400 mono-font ml-2">master_solution_core.exe</span>
                            </div>
                            <span class="text-xs text-amber-400 mono-font">v16.0 Aktif</span>
                        </div>
                        <div id="master-terminal" class="p-5 font-mono text-xs sm:text-sm text-amber-300 space-y-2 overflow-y-auto max-h-80 leading-relaxed">
                            <span class="text-slate-500">// Furkan Kutay Çağanay Master Sistemi Hazır.</span><br>
                            <span class="text-emerald-400">> Spor protokolü: Yüklendi.</span><br>
                            <span class="text-sky-300">> Zihinsel odak (Focus State): Aktif.</span><br>
                            <span class="text-amber-400">> Lütfen "Tek Tuşla Her Şeyi Çöz" butonuna basın.</span>
                        </div>
                        <div class="p-3 bg-slate-900/50 border-t border-slate-800 flex justify-between items-center text-xs text-slate-400">
                            <span>Durum: Beklemede</span>
                            <button onclick="clearMasterTerminal()" class="text-rose-400 hover:text-rose-300">Terminali Sıfırla</button>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- WORKOUT TAB: SPOR VE ANLIK KOÇLUK -->
        <div id="tab-workout" class="hidden space-y-8">
            <section class="glass-panel rounded-3xl p-8 sm:p-10 space-y-6">
                <div class="flex items-center space-x-4 border-b border-slate-800 pb-4">
                    <div class="p-3 rounded-2xl bg-amber-500/10 text-amber-400 text-2xl font-black">🏋️</div>
                    <div>
                        <h3 class="text-xl font-bold text-white cinzel-font">Dambılsız Patlayıcı Kuvvet & Boks Simülatörü</h3>
                        <p class="text-sm text-slate-400">Evde, sahilde veya havuz kenarında yapabileceğiniz sıfır bağımlılık antrenman programı</p>
                    </div>
                </div>
                <div class="grid md:grid-cols-3 gap-6">
                    <div class="p-6 rounded-2xl bg-slate-950/90 border border-slate-800 space-y-3">
                        <span class="text-xs text-amber-400 font-mono">EGZERSİZ #1</span>
                        <h4 class="font-bold text-white text-base">Patlayıcı Şınav (Explosive Push-Up)</h4>
                        <p class="text-xs text-slate-300 leading-relaxed">Göğüs kafesini suya dalış anına hazırlar. Bas vuruşu (beat) anında elleri yerden kesin.</p>
                        <span class="inline-block px-3 py-1 rounded-full bg-amber-500/10 text-amber-300 text-xs font-mono">4 Set x 12 Tekrar (45sn Dinlenme)</span>
                    </div>
                    <div class="p-6 rounded-2xl bg-slate-950/90 border border-slate-800 space-y-3">
                        <span class="text-xs text-amber-400 font-mono">EGZERSİZ #2</span>
                        <h4 class="font-bold text-white text-base">Geniş Tutuş Barfiks (Pull-Up)</h4>
                        <p class="text-xs text-slate-300 leading-relaxed">Sırt ve kanat mimarisini güçlendirir. Sallanmadan saf kontrolle yukarı çekin.</p>
                        <span class="inline-block px-3 py-1 rounded-full bg-amber-500/10 text-amber-300 text-xs font-mono">4 Set x Maksimum Tükeniş</span>
                    </div>
                    <div class="p-6 rounded-2xl bg-slate-950/90 border border-slate-800 space-y-3">
                        <span class="text-xs text-amber-400 font-mono">EGZERSİZ #3</span>
                        <h4 class="font-bold text-white text-base">Boks Gölge & Ayak Oyunu (Footwork)</h4>
                        <p class="text-xs text-slate-300 leading-relaxed">Ağırlığı asla topuklara vermeyin. Milimetrik jablar ve patlayıcı pivot dönüşleri yapın.</p>
                        <span class="inline-block px-3 py-1 rounded-full bg-amber-500/10 text-amber-300 text-xs font-mono">3 Raund x 3 Dakika</span>
                    </div>
                </div>
            </section>
        </div>

        <!-- ACADEMY TAB: ÖĞRETİCİ KÜLLİYAT -->
        <div id="tab-academy" class="hidden space-y-8">
            <section class="glass-panel rounded-3xl p-8 sm:p-10 space-y-6">
                <div class="flex items-center space-x-4 border-b border-slate-800 pb-4">
                    <div class="p-3 rounded-2xl bg-amber-500/10 text-amber-400 text-2xl font-black">📚</div>
                    <div>
                        <h3 class="text-xl font-bold text-white cinzel-font">Öğreten Bilgi Bankası ve Manifestolar</h3>
                        <p class="text-sm text-slate-400">Furkan Kutay Çağanay ekolünün felsefesi ve hayatı öğrenme rehberi</p>
                    </div>
                </div>
                <div class="grid md:grid-cols-2 gap-4">
                    <div onclick="showLesson('felsefe')" class="p-5 rounded-2xl bg-slate-950/90 border border-slate-800 hover:border-amber-500/50 cursor-pointer transition space-y-2">
                        <span class="text-xs text-amber-400 font-mono">DERS #1</span>
                        <h4 class="font-bold text-white text-sm">Sıfır Bağımlılık (Zero-Dependency) Nedir?</h4>
                        <p class="text-xs text-slate-400">Dış etkenlere ve hantal sistemlere sırt çevirip kendi öz iradenizle başarma sanatı.</p>
                    </div>
                    <div onclick="showLesson('odak')" class="p-5 rounded-2xl bg-slate-950/90 border border-slate-800 hover:border-amber-500/50 cursor-pointer transition space-y-2">
                        <span class="text-xs text-amber-400 font-mono">DERS #2</span>
                        <h4 class="font-bold text-white text-sm">Akustik Fokus ve Zihinsel Tünel</h4>
                        <p class="text-xs text-slate-400">Trap müzik bas frekanslarıyla dış gürültüyü filtreleme ve maksimum verim alma kılavuzu.</p>
                    </div>
                </div>
                <!-- Lesson Output Box -->
                <div id="lesson-box" class="hidden p-6 rounded-2xl bg-slate-950 border border-amber-500/40 space-y-4">
                    <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                        <h4 id="lesson-title" class="font-bold text-white text-base cinzel-font text-amber-400">Başlık</h4>
                        <button onclick="closeLesson()" class="text-xs text-rose-400 hover:text-rose-300 font-mono">Kapat [X]</button>
                    </div>
                    <div id="lesson-content" class="text-xs sm:text-sm text-slate-300 leading-relaxed font-mono whitespace-pre-line">
                        İçerik yükleniyor...
                    </div>
                </div>
            </section>
        </div>

        <!-- SHIELD TAB: KUANTUM KORUMA -->
        <div id="tab-shield" class="hidden space-y-8">
            <section class="glass-panel rounded-3xl p-8 sm:p-10 space-y-6">
                <div class="flex items-center space-x-4 border-b border-slate-800 pb-4">
                    <div class="p-3 rounded-2xl bg-emerald-500/10 text-emerald-400 text-2xl font-black">🛡️</div>
                    <div>
                        <h3 class="text-xl font-bold text-white cinzel-font">Kuantum Altın Oran (1.618) Koruma Zırhı</h3>
                        <p class="text-sm text-slate-400">Finansal varlıklar, mülkler ve yaşam çemberinin mutlak mühürlenmesi</p>
                    </div>
                </div>
                <div class="p-6 rounded-2xl bg-slate-950/90 border border-slate-800 space-y-4">
                    <h4 class="font-bold text-white text-base">Zırh Durumu: Aktif ve Koruma Altında</h4>
                    <p class="text-xs text-slate-300 leading-relaxed">Tüm banka hesaplarınız, tapularınız, dostluk çemberiniz ve gelecek planlarınız altın oran gümüş şifreleme ağıyla dış risklere karşı %100 mühürlenmiştir.</p>
                    <button onclick="alert('Kuantum Gümüş Zırh v16.0 başarıyla tarandı ve doğrulandı. Her şey güvence altında!')" class="px-5 py-2.5 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-xs font-mono font-bold hover:bg-emerald-500/30 transition">
                        🔍 Zırhı ve Varlıkları Doğrula
                    </button>
                </div>
            </section>
        </div>

    </main>

    <footer class="max-w-7xl mx-auto px-6 mt-16 text-center text-xs text-slate-500 font-mono">
        <p>© 2026 Furkan Kutay Çağanay • Her Şeyi Çözen Mutlak Sistem v16.0</p>
    </footer>

    <script>
        function switchTab(tabId) {
            document.querySelectorAll('[id^="tab-"]').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');
            
            document.querySelectorAll('header nav button').forEach(btn => {
                btn.classList.remove('bg-amber-500/15', 'text-amber-300', 'border', 'border-amber-500/40', 'font-bold');
                btn.classList.add('hover:bg-slate-800', 'hover:text-amber-300');
            });
            event.target.classList.remove('hover:bg-slate-800', 'hover:text-amber-300');
            event.target.classList.add('bg-amber-500/15', 'text-amber-300', 'border', 'border-amber-500/40', 'font-bold');
        }

        function executeTotalMasterSolution() {
            let term = document.getElementById('master-terminal');
            let steps = [
                `<span class="text-amber-400">> [1/4] Spor protokolü devreye alındı: Calisthenics & patlayıcı şınavlar aktif!</span>`,
                `<span class="text-sky-300">> [2/4] Zihinsel odak tüneli (Focus State) kuruldu. Dış gürültüler filtrelendi.</span>`,
                `<span class="text-purple-300">> [3/4] Öğrenme ve bilgi motoru yüklendi: Sıfır bağımlılık prensibi işlendi.</span>`,
                `<span class="text-emerald-400">✔ [4/4] HARİKA! Her şey çözüldü. Varlıklar mühürlendi, spor yapıldı ve zihin aydınlandı!</span>`
            ];
            
            let i = 0;
            term.innerHTML += `<br><span class="text-slate-500">--- Master Çözüm Başlatıldı ---</span><br>`;
            
            let interval = setInterval(() => {
                if(i < steps.length) {
                    term.innerHTML += steps[i] + "<br>";
                    term.scrollTop = term.scrollHeight;
                    i++;
                } else {
                    clearInterval(interval);
                }
            }, 300);
        }

        function clearMasterTerminal() {
            document.getElementById('master-terminal').innerHTML = '<span class="text-slate-500">// Terminal sıfırlandı. Yeni komut bekleniyor...</span>';
        }

        const lessons = {
            felsefe: {
                title: "Sıfır Bağımlılık (Zero-Dependency) Nedir?",
                content: "Başarı için dışarıdaki karmaşık makinelere, hantal aparatlara veya başkalarının sistemlerine muhtaç olmamak demektir. Güç, sizin kendi bedeninizde, iradenizde ve zihninizdedir. İstediğiniz an, istediğiniz yerde zirveye çıkabilirsiniz."
            },
            odak: {
                title: "Akustik Fokus ve Zihinsel Tünel",
                content: "Antrenman veya çalışma sırasında dinlediğiniz ritmik bas frekansları (trap müzik beat'leri), beyindeki dikkat dağınıklığını keser. Sizi zamanın dışına taşıyan bu akustik kalkan sayesinde yaptığınız işe tamamen mühürlenirsiniz."
            }
        };

        function showLesson(key) {
            const box = document.getElementById('lesson-box');
            const titleEl = document.getElementById('lesson-title');
            const contentEl = document.getElementById('lesson-content');
            
            if(lessons[key]) {
                titleEl.textContent = lessons[key].title;
                contentEl.textContent = lessons[key].content;
                box.classList.remove('hidden');
                box.scrollIntoView({ behavior: 'smooth' });
            }
        }

        function closeLesson() {
            document.getElementById('lesson-box').classList.add('hidden');
        }
    </script>
</body>
</html>
