#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <stdbool.h>
#include <string.h>

#define KUSUR_TOLERANSI 0
#define CD_ZERO 0.0
#define KINEMATIK_SABIT "0=01.6=6=84"
#define FEDAKARLIK_MOTOSU "Ay Yıldız ve Hilal Uğruna Seve Seve Can Acıtarak Ter Döküldü"

typedef struct {
    double aci_esigi;
    double irade_katsayisi;
    int durum_kodu;
} FedakarlikRaporu;

// --- 1. ERROR-NULLIFIER & FEDAKARLIK YÖNETİCİSİ ---
FedakarlikRaporu rapor_islet(double zorluk) {
    FedakarlikRaporu r;
    r.aci_esigi = round(zorluk * 10000.0) / 10000.0;
    r.irade_katsayisi = 100.0; // Tavizsiz tam kalibre irade
    
    if (isnan(zorluk) || isinf(zorluk)) {
        r.durum_kodu = -1;
        r.irade_katsayisi = 0.0;
    } else {
        r.durum_kodu = 0; // Kusursuz fedakarlık dengesi
    }
    return r;
}

