}

// --- 4. KINEMATİK RAPOR ÇIKTI MOTORU ---
void rapor_cikti_motoru() {
    printf("=================================================================\n");
    printf(" [!] KINEMATİK FEDAKARLIK VE İRADE RAPORU AKTİF\n");
    printf("=================================================================\n");
    
    double metrikler[] = { 84.1601, 6.0184, 19.23, 23.00 };
    for(int i = 0; i < 4; i++) {
        FedakarlikRaporu res = rapor_islet(metrikler[i] * 3.14159);
        printf(" -> Modül Log [%d] | Ağrı/Zorluk: %.4f | İrade Gücü: %%.2f | Durum: %d\n", 
            i, res.aci_esigi, res.irade_katsayisi, res.durum_kodu);
    }
    printf("=================================================================\n");
    printf(" [RAPOR SONUCU] Kusur Yok, Acı Mukaddes Uğura Feda Edildi!\n");
    printf("=================================================================\n\n");
}

