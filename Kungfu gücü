<!DOCTYPE html>
<html lang="tr" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Furkan Kutay Çağanay • Kutay Kungfu & Güvenli Matematiksel Analitik Protokolü</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&family=JetBrains+Mono:wght@400;700&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .cinzel-font { font-family: 'Cinzel', serif; }
        .mono-font { font-family: 'JetBrains Mono', monospace; }
        .glass-panel {
            background: rgba(4, 7, 13, 0.96);
            backdrop-filter: blur(40px);
            -webkit-backdrop-filter: blur(40px);
            border: 1px solid rgba(212, 175, 55, 0.5);
        }
        .gold-glow { text-shadow: 0 0 40px rgba(212, 175, 55, 0.8); }
        .golden-border { border-image: linear-gradient(to right, #d4af37, #e2e8f0, #d4af37) 1; }
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #02040a; }
        ::-webkit-scrollbar-thumb { background: #d4af37; border-radius: 4px; }
        @keyframes quantumPulse {
            0%, 100% { box-shadow: 0 0 40px rgba(212, 175, 55, 0.3), inset 0 0 20px rgba(212, 175, 55, 0.15); }
            50% { box-shadow: 0 0 80px rgba(212, 175, 55, 0.7), inset 0 0 40px rgba(212, 175, 55, 0.4); }
        }
        .quantum-shield { animation: quantumPulse 3s infinite ease-in-out; }
    </style>
</head>
<body class="bg-[#02040a] text-slate-100 min-h-screen selection:bg-amber-500 selection:text-slate-950 pb-32">

    <header class="sticky top-0 z-50 glass-panel border-b border-amber-500/30">
        <div class="max-w-7xl mx-auto px-6 py-4 flex flex-col md:flex-row items-center justify-between gap-4">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-600 via-yellow-400 to-slate-200 flex items-center justify-center font-black text-xl text-slate-950 shadow-2xl shadow-amber-500/50 cinzel-font">
                    KK
                </div>
                <div>
                    <h1 class="text-base sm:text-lg font-black tracking-tight text-white flex items-center gap-2 cinzel-font">
                        KUTAY KUNGFU PROTOKOLÜ
                        <span class="inline-block w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping" title="Sistem Aktif"></span>
                    </h1>
                    <p class="text-xs text-amber-400 font-semibold uppercase tracking-wider mono-font">Furkan Kutay Çağanay • Güvenli Matematiksel Analitik Konsol</p>
                </div>
            </div>
            <nav class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 text-xs sm:text-sm font-medium text-slate-300">
                <button onclick="switchTab('strike')" class="tab-btn px-4 py-2 rounded-xl bg-amber-500/15 text-amber-300 border border-amber-500/40 transition shadow-sm font-bold">🥋 Kungfu Vuruş Matematiği</button>
                <button onclick="switchTab('security')" class="tab-btn px-4 py-2 rounded-xl hover:bg-slate-800 hover:text-amber-300 transition">🛡️ Güvenli Analitik Zırh</button>
                <button onclick="switchTab('terminal')" class="tab-btn px-4 py-2 rounded-xl hover:bg-slate-800 hover:text-amber-300 transition">⚡ Canlı Terminal</button>
            </nav>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-6 pt-10 space-y-12">
        
        <!-- STRIKE TAB: KUNGFU VURUŞ MATEMATİĞİ -->
        <div id="tab-strike" class="space-y-8">
            <section class="glass-panel rounded-3xl p-8 sm:p-12 relative overflow-hidden shadow-2xl quantum-shield golden-border border-t-2 border-b-2">
                <div class="absolute -right-32 -top-32 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
                
                <div class="relative z-10 grid lg:grid-cols-2 gap-10 items-center">
                    <div class="space-y-6">
                        <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold uppercase tracking-wider mono-font">
                            <span>Zero-Dependency (Sıfır Bağımlılık) Savaş Sanatı</span>
                        </div>
                        <h2 class="text-3xl sm:text-4xl font-black tracking-tight text-white gold-glow cinzel-font leading-tight">
                            Kutay Kungfu & Patlayıcı Kuvvet Hesaplayıcı
                        </h2>
                        <p class="text-sm text-slate-300 leading-relaxed">
                            Aparatlara muhtaç olmadan, insan bedeninin saf biyomekaniği ve milisaniyelik reaksiyon süresi ile üretilen mutlak vuruş gücünü hesaplayın.
                        </p>

                        <!-- Calculator Inputs -->
                        <div class="space-y-4 pt-2">
                            <div>
                                <label class="block text-xs font-mono text-amber-400 mb-1">Kol / Yumruk Kütlesi (kg):</label>
                                <input type="number" id="kung-mass" value="12" class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white mono-font focus:border-amber-500 outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-mono text-amber-400 mb-1">İvmelenme / Reaksiyon Süresi (Salise - sn):</label>
                                <input type="number" step="0.01" id="kung-time" value="0.08" class="w-full px-4 py-3 rounded-xl bg-slate-950 border border-slate-800 text-white mono-font focus:border-amber-500 outline-none">
                            </div>
                            <button onclick="calculateKungFu()" class="w-full py-4 rounded-xl bg-gradient-to-r from-amber-600 via-yellow-500 to-amber-700 hover:from-amber-500 hover:to-amber-600 text-slate-950 font-extrabold text-sm transition shadow-lg shadow-amber-500/30 flex items-center justify-center gap-2">
                                <span>⚡ Kutay Kungfu Vuruş Gücünü Hesapla</span>
                            </button>
                        </div>
                    </div>

                    <!-- Results Panel -->
                    <div class="flex flex-col rounded-2xl bg-slate-950 border border-slate-800 overflow-hidden shadow-inner p-6 space-y-6">
                        <div class="border-b border-slate-800 pb-3 flex justify-between items-center">
                            <span class="text-xs text-amber-400 mono-font">MATEMATİKSEL VURUŞ RAPORU</span>
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                        </div>
                        
                        <div class="space-y-4 font-mono text-xs sm:text-sm text-slate-300">
                            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 flex justify-between items-center">
                                <span class="text-slate-400">Üretilen Darbe Gücü (Force):</span>
                                <span id="res-kung-force" class="text-amber-400 font-bold">-- N</span>
                            </div>
                            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 flex justify-between items-center">
                                <span class="text-slate-400">Kungfu Refleks Katsayısı:</span>
                                <span id="res-kung-score" class="text-emerald-400 font-bold">-- Puan</span>
                            </div>
                            <div class="p-4 rounded-xl bg-slate-900 border border-slate-800 flex justify-between items-center">
                                <span class="text-slate-400">Güvenlik Doğrulaması:</span>
                                <span class="text-sky-300 font-bold">%100 Saf İrade</span>
                            </div>
                        </div>

                        <div class="p-4 rounded-xl bg-amber-500/10 border border-amber-500/30 text-xs text-amber-300 leading-relaxed font-mono">
                            "Kutay Kungfu sisteminde güç makinelerden değil, zihnin odaklanma hızından ve saf matematiksel ivmeden gelir."
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- SECURITY TAB: GÜVENLİ ANALİTİK ZIRH -->
        <div id="tab-security" class="hidden space-y-8">
            <section class="glass-panel rounded-3xl p-8 sm:p-10 space-y-6">
                <div class="flex items-center space-x-4 border-b border-slate-800 pb-4">
                    <div class="p-3 rounded-2xl bg-emerald-500/10 text-emerald-400 text-2xl font-black">🛡️</div>
                    <div>
                        <h3 class="text-xl font-bold text-white cinzel-font">Güvenli Matematiksel Analitik Protokolü</h3>
                        <p class="text-sm text-slate-400">Algoritmik bütünlük ve dış saldırılara karşı sıfır bağımlılık koruması</p>
                    </div>
                </div>
                <div class="grid md:grid-cols-2 gap-6">
                    <div class="p-6 rounded-2xl bg-slate-950/90 border border-slate-800 space-y-3">
                        <span class="text-xs text-amber-400 font-mono">PROTOKOL #1</span>
                        <h4 class="font-bold text-white text-base">Deterministik Kriptografik Zırh</h4>
                        <p class="text-xs text-slate-300 leading-relaxed">Tüm analitik veriler altın oran (1.618) matrisine göre şifrelenir ve dış entropiye karşı mühürlenir.</p>
                    </div>
                    <div class="p-6 rounded-2xl bg-slate-950/90 border border-slate-800 space-y-3">
                        <span class="text-xs text-amber-400 font-mono">PROTOKOL #2</span>
                        <h4 class="font-bold text-white text-base">Milisaniyelik Doğrulama</h4>
                        <p class="text-xs text-slate-300 leading-relaxed">Sistem yanıt süresi 100 milisaniyenin altında tutularak en yüksek performans kararlılığı sağlanır.</p>
                    </div>
                </div>
                <button onclick="verifyProtocolSecurity()" class="w-full py-4 rounded-xl bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-xs font-mono font-bold hover:bg-emerald-500/30 transition">
                    🔍 Protokolü Doğrula ve Mühürle
                </button>
            </section>
        </div>

        <!-- TERMINAL TAB: CANLI TERMINAL -->
        <div id="tab-terminal" class="hidden space-y-8">
            <section class="glass-panel rounded-3xl p-8 sm:p-10 space-y-6">
                <div class="flex items-center space-x-4 border-b border-slate-800 pb-4">
                    <div class="p-3 rounded-2xl bg-amber-500/10 text-amber-400 text-2xl font-black">⚡</div>
                    <div>
                        <h3 class="text-xl font-bold text-white cinzel-font">Furkan Kutay Çağanay Canlı Konsol Terminali</h3>
                        <p class="text-sm text-slate-400">Sistem komutlarını çalıştırın ve analitik raporları inceleyin</p>
                    </div>
                </div>
                
                <div class="flex flex-col rounded-2xl bg-slate-950 border border-slate-800 overflow-hidden shadow-inner">
                    <div class="px-4 py-3 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <div class="w-3 h-3 rounded-full bg-rose-500"></div>
                            <div class="w-3 h-3 rounded-full bg-amber-500"></div>
                            <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
                            <span class="text-xs text-slate-400 mono-font ml-2">kutay_kungfu_core.exe</span>
                        </div>
                        <span class="text-xs text-amber-400 mono-font">v18.0 Aktif</span>
                    </div>
                    <div id="terminal-output" class="p-5 font-mono text-xs sm:text-sm text-amber-300 space-y-2 overflow-y-auto max-h-80 leading-relaxed">
                        <span class="text-slate-500">// Kutay Kungfu Güvenli Analitik Konsol Başlatıldı.</span><br>
                        <span class="text-emerald-400">> Sıfır bağımlılık kütüphanesi yüklendi.</span><br>
                        <span class="text-sky-300">> Matematiksel koruma zırhı etkinleştirildi.</span><br>
                    </div>
                    <div class="p-3 bg-slate-900/50 border-t border-slate-800 flex justify-between items-center text-xs text-slate-400">
                        <span>Durum: Beklemede</span>
                        <button onclick="runTerminalCommand()" class="px-4 py-2 rounded-lg bg-amber-500 text-slate-950 font-bold">Komut Çalıştır</button>
                    </div>
                </div>
            </section>
        </div>

    </main>

    <footer class="max-w-7xl mx-auto px-6 mt-16 text-center text-xs text-slate-500 font-mono">
        <p>© 2026 Furkan Kutay Çağanay • Kutay Kungfu & Güvenli Matematiksel Analitik Protokolü</p>
    </footer>

    <script>
        function switchTab(tabId) {
            document.querySelectorAll('[id^="tab-"]').forEach(el => el.classList.add('hidden'));
            document.getElementById('tab-' + tabId).classList.remove('hidden');
            
            document.querySelectorAll('header nav button').forEach(btn => {
                btn.classList.remove('bg-amber-500/15', 'text-amber-300', 'border', 'border-amber-500/40', 'font-bold');
                btn.classList.add('hover:bg-slate-800', 'hover:text-amber-300');
            });
            event.target.classList.remove('hover:bg-slate-800', 'hover:text-amber-300');
            event.target.classList.add('bg-amber-500/15', 'text-amber-300', 'border', 'border-amber-500/40', 'font-bold');
        }

        function calculateKungFu() {
            let mass = parseFloat(document.getElementById('kung-mass').value) || 12;
            let time = parseFloat(document.getElementById('kung-time').value) || 0.08;

            let acceleration = 9.81 / Math.max(time, 0.01);
            let force = (mass * acceleration).toFixed(1);
            let score = Math.max(100 - (time * 400), 10).toFixed(1);

            document.getElementById('res-kung-force').textContent = force + " Newton (N)";
            document.getElementById('res-kung-score').textContent = score + " / 100 Elit Puan";
        }

        function verifyProtocolSecurity() {
            let term = document.getElementById('terminal-output');
            term.innerHTML += `<br><span class="text-emerald-400">✔ Güvenli Analitik Zırh başarıyla doğrulandı. Tüm protokoller mühürlendi!</span>`;
            switchTab('terminal');
        }

        function runTerminalCommand() {
            let term = document.getElementById('terminal-output');
            term.innerHTML += `<br><span class="text-amber-400">> Kutay Kungfu analitik motoru taraması tamamlandı: %100 Kararlı.</span>`;
            term.scrollTop = term.scrollHeight;
        }

        window.onload = function() {
            calculateKungFu();
        };
    </script>
</body>
</html>
