#include <stdio.h>
#include <stdlib.h>
#include <math.h>
#include <stdbool.h>
#include <string.h>

#define KUSUR_TOLERANSI 0
#define CD_ZERO 0.0
#define KINEMATIK_SABIT "AY-01/HILAL-06/YILDIZ-84"
#define VATAN_MOTORU "Ay Yıldız & Hilal"

typedef enum {
    DURUM_GUVENLI = 0,
    DURUM_TEHLİKE = -1
} Durum;

typedef struct {
    double ham_veri;
    double carpismazlik_orani;
    Durum islem_durumu;
} RefleksMatrisi;

static void cizgi_yap(const char *baslik, int uzunluk) {
    printf(" ");
    for (int i = 0; i < uzunluk; i++) {
        putchar('=');
    }
    printf("\n");
    (void)baslik;
}

static double girdi_iyi_hale_getir(double x) {
    if (isnan(x) || isinf(x)) {
        return 0.0;
    }
    return x;
}

RefleksMatrisi islem_calistir(double girdi) {
    RefleksMatrisi r;

    r.ham_veri = girdi;
    r.carpismazlik_orani = round(girdi * 10000.0) / 10000.0;

    if (isnan(girdi) || isinf(girdi)) {
        r.islem_durumu = DURUM_TEHLİKE;
        r.carpismazlik_orani = 0.0;
    } else {
        r.islem_durumu = DURUM_GUVENLI;
    }

    return r;
}

