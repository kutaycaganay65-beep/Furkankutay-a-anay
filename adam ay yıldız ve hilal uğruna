void combat_testi(void) {
    cizgi_yap("TEST", 68);
    printf(" [!] AY YILDIZ HİLAL REFLEKS VE KOMBAT TESTİ ÇALIŞTIRILIYOR\n");
    cizgi_yap("TEST", 68);

    double veriler[] = { 84.1601, 6.0184, 19.23, 23.00, 45.75, 88.12 };
    int n = sizeof(veriler) / sizeof(veriler[0]);

    for (int i = 0; i < n; i++) {
        double girdi = girdi_iyi_hale_getir(veriler[i] * 3.14159);
        RefleksMatrisi sonuc = islem_calistir(girdi);

        printf(" -> Refleks Modülü [%d] | Ham: %.4f | Çıktı: %.4f | Durum: %d\n",
               i, sonuc.ham_veri, sonuc.carpismazlik_orani, sonuc.islem_durumu);
    }

    printf("\n");
    printf(" [RAPOR] Kusur Toleransı: %d | Denge: %s | Hız: %s | İrade: %s\n",
           KUSUR_TOLERANSI, "Mükemmel", "Kırılmaz", "Sonsuz");
    cizgi_yap("TEST", 68);
    printf("\n");
}

void hata_nullifier(void) {
    double bozucu[] = { NAN, INFINITY, -INFINITY, 123.4567 };

    printf(">> [NULLIFIER / ERROR-NULLIFIER / HATA EMNİYETİ]:\n");
    for (int i = 0; i < 4; i++) {
        RefleksMatrisi sonuc = islem_calistir(bozucu[i]);
        printf("   - Girdi: %s | Çıktı: %.4f | Durum: %d\n",
               isnan(bozucu[i]) || isinf(bozucu[i]) ? "TEHLİKE" : "NORMAL",
               sonuc.carpismazlik_orani, sonuc.islem_durumu);
    }
    printf("\n");
}

