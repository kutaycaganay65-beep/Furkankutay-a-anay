<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nizam-ı Âlem // Absolute Deterministic Defense Core</title>
    <style>
        :root {
            --bg-color: #050505;
            --panel-bg: #0a0e11;
            --border-color: #1e293b;
            --accent-green: #10b981;
            --accent-glow: rgba(16, 185, 129, 0.15);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --font-mono: 'Courier New', Courier, monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            line-height: 1.6;
            padding: 2rem 1rem;
        }

        .container {
            max-width: 950px;
            margin: 0 auto;
        }

        header {
            border-bottom: 2px solid var(--accent-green);
            padding-bottom: 1.5rem;
            margin-bottom: 2rem;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            flex-wrap: wrap;
            gap: 1rem;
        }

        .title-group h1 {
            font-size: 1.8rem;
            letter-spacing: 2px;
            color: var(--text-main);
            text-transform: uppercase;
        }

        .title-group p {
            color: var(--accent-green);
            font-family: var(--font-mono);
            font-size: 0.9rem;
            margin-top: 0.3rem;
        }

        .badge {
            background: var(--accent-glow);
            border: 1px solid var(--accent-green);
            color: var(--accent-green);
            padding: 0.4rem 0.8rem;
            font-family: var(--font-mono);
            font-size: 0.8rem;
            text-transform: uppercase;
            border-radius: 2px;
        }

        .section {
            background: var(--panel-bg);
            border: 1px solid var(--border-color);
            border-radius: 4px;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
        }

        .section h2 {
            font-size: 1.1rem;
            color: var(--accent-green);
            font-family: var(--font-mono);
            margin-bottom: 1rem;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        p.desc {
            color: var(--text-muted);
            margin-bottom: 1rem;
            font-size: 0.95rem;
        }

        pre {
            background: #020405;
            border: 1px solid var(--border-color);
            padding: 1.2rem;
            overflow-x: auto;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            color: #38bdf8;
            border-radius: 3px;
            max-height: 400px;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 1rem;
            margin-top: 1rem;
        }

        .metric-card {
            background: #020405;
            border: 1px solid var(--border-color);
            padding: 1rem;
            border-radius: 3px;
        }

        .metric-card h3 {
            font-size: 0.9rem;
            color: var(--text-main);
            margin-bottom: 0.3rem;
            font-family: var(--font-mono);
        }

        .metric-card p {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        footer {
            text-align: center;
            color: var(--text-muted);
            font-family: var(--font-mono);
            font-size: 0.8rem;
            margin-top: 3rem;
            border-top: 1px solid var(--border-color);
            padding-top: 1.5rem;
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- HEADER -->
        <header>
            <div class="title-group">
                <h1>Nizam-ı Âlem</h1>
                <p>// Ultimate Hard Real-Time & Zero-Allocation Defense Core</p>
            </div>
            <div class="badge">Status: Ultimate / Hardened</div>
        </header>

        <!-- PHILOSOPHY & DISCIPLINE -->
        <div class="section">
            <h2>01. Mimari Felsefe & Disiplin (Boksör Gardı & Saf C)</h2>
            <p class="desc">Savunma sanayiinde aranan o kusursuz disiplin; ringdeki sarsılmaz gard, havuzdaki sıfır sürtünme ve kodda mutlak determinizm ile birleşir.</p>
            
            <div class="metrics-grid">
                <div class="metric-card">
                    <h3>Zero-Allocation</h3>
                    <p>Dinamik bellek tahsisi (`malloc`/`free`) kesinlikle yasaktır. Tüm bellek derleme aşamasında statik olarak rezerve edilir.</p>
                </div>
                <div class="metric-card">
                    <h3>Buffer Overflow Proof</h3>
                    <p>Sınır denetimleri (`bound checking`) sayesinde tampon taşmalarına ve harici darbelere karşı zırhlı koruma sağlanır.</p>
                </div>
                <div class="metric-card">
                    <h3>Checksum & Integrity</h3>
                    <p>Görünmeyen veri manipülasyonları bit düzeyinde bütünlük taramalarıyla anında tespit edilir ve engellenir.</p>
                </div>
            </div>
        </div>

        <!-- ULTIMATE KERNEL CODE -->
        <div class="section">
            <h2>02. Nihai Çekirdek Güvenlik Kodu (C / Bare-Metal)</h2>
            <p class="desc">Hata kodları dokümante edilmiş, bütünlük korumalı ve statik test simülasyonlu nihai mimari:</p>
            <pre><code>/* ========================================================================== */
/*  NİZAM-I ÂLEM: ABSOLUTE DETERMINISTIC DEFENSE KERNEL (v2.0-ULTIMATE)       */
/*  Architect: Furkan Kutay Çağanay                                           */
/* ========================================================================== */

#include &lt;stdint.h&gt;
#include &lt;stdbool.h&gt;

#define MAX_BUFFER_SIZE         256
#define SYSTEM_STATUS_READY     0x01

#define ERR_SUCCESS             0
#define ERR_NULL_POINTER        -1
#define ERR_BUFFER_OVERFLOW     -2
#define ERR_HARDWARE_FAULT      -3
#define ERR_STATE_VIOLATION     -4

#define SYS_BASE_CTRL_REG       ((volatile uint32_t*) 0x40001000)
#define SYS_STATUS_REG          ((volatile uint32_t*) 0x40001004)
#define WATCHDOG_TIMER_REG      ((volatile uint32_t*) 0x40001008)

typedef struct {
    uint32_t timestamp;
    float telemetry_data[MAX_BUFFER_SIZE];
    uint16_t data_length;
    uint8_t status_flag;
    uint8_t checksum;
} SecureTelemetryPacket;

int32_t process_guarded_packet(const SecureTelemetryPacket *restrict packet) {
    if (packet == (void*)0 || packet->status_flag != SYSTEM_STATUS_READY) {
        return ERR_NULL_POINTER; 
    }
    if (packet->data_length &gt; MAX_BUFFER_SIZE || packet->data_length == 0) {
        return ERR_BUFFER_OVERFLOW; 
    }
    
    float calculated_sum = 0.0f;
    for (uint16_t i = 0; i &lt; MAX_BUFFER_SIZE; i++) {
        if (i &lt; packet->data_length) {
            calculated_sum += packet->telemetry_data[i];
        }
    }
    return ERR_SUCCESS; 
}</code></pre>
