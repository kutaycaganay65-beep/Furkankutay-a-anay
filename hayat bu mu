typedef struct {
    double yuk_orani;
    double anlam_katsayisi;
    int existential_durum;
} HayatSorguMatrisi;

// --- 1. EXISTENTIAL ERROR-NULLIFIER & SORGULAMA MOTORU ---
HayatSorguMatrisi hayat_sorgula(double agirlik) {
    HayatSorguMatrisi m;
    m.yuk_orani = round(agirlik * 10000.0) / 10000.0;
    m.anlam_katsayisi = 100.0; // Ağır ama tam anlamlı
    
    if (isnan(agirlik) || isinf(agirlik)) {
        m.existential_durum = -1;
        m.anlam_katsayisi = 0.0;
    } else {
        m.existential_durum = 0; // Kusursuz kabul ve irade
    }
    return m;
}

